# Port the web server listens on
PORT=3000

# Google Cloud OAuth client (APIs & Services > Credentials > OAuth client ID > Web application)
# Enable the "Google Drive API" for the project first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Anthropic API key used to answer questions from indexed file content.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
